# Normalise line endings: LF in the repository, native in the working copy.
# Keeps Windows development and Linux CI runners from fighting over CRLF.
* text=auto eol=lf

# Binary assets — never touch these
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.pdf   binary
*.xlsx  binary
*.xls   binary
